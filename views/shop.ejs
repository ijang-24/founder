<%- include('partials/head') %>

    <!-- Header -->
    <section class="py-10 bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <h1 class="font-bold text-3xl text-gray-900 mb-6">Shop</h1>

        <!-- Filters -->
        <form method="GET" action="/shop" class="flex flex-col sm:flex-row gap-3">
          <input type="text" name="search" placeholder="Cari produk..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            class="flex-1 border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#22562A]" />

          <select name="category"
            class="border border-gray-300 rounded-lg px-4 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-[#22562A]">
            <option value="all" <%= (typeof selectedCategory === 'undefined' || selectedCategory === 'all') ? 'selected' : '' %>>Semua Kategori</option>
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            <% } %>
          </select>

          <button type="submit"
            class="bg-[#22562A] text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-green-800 transition-colors">
            Cari
          </button>
        </form>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="py-10">
      <div class="max-w-7xl mx-auto px-6">
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
          <p class="text-sm text-gray-500 mb-6"><%= products.length %> produk ditemukan</p>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% products.forEach(product => { %>
              <a href="/product/<%= product.slug %>" class="group">
                <div class="bg-gray-50 rounded-xl overflow-hidden mb-3 aspect-[3/4]">
                  <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=400' %>"
                    alt="<%= product.name %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-medium text-gray-900 text-sm mb-1 truncate"><%= product.name %></h3>
                <p class="text-[#22562A] font-semibold text-sm">Rp <%= product.price ? product.price.toLocaleString('id-ID') : '-' %></p>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-20">
            <p class="text-gray-400 text-lg mb-4">Produk tidak ditemukan</p>
            <a href="/shop" class="text-[#22562A] font-medium hover:underline">Reset filter</a>
          </div>
        <% } %>
      </div>
    </section>

<%- include('partials/footer') %>
