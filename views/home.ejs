<%- include('partials/head') %>

    <!-- Hero Banner -->
    <section class="relative h-[85vh] bg-cover bg-center overflow-hidden"
      style="background-image: url('https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1400&q=80')">
      <div class="absolute inset-0 bg-[#22562A]/60"></div>
      <div class="relative z-10 h-full flex items-center px-6 max-w-7xl mx-auto">
        <div>
          <h1 class="font-bold text-6xl md:text-7xl text-white tracking-widest mb-4">FOUNDER</h1>
          <p class="text-xl text-white/80 mb-8">Everyday pieces, made for you.</p>
          <a href="/shop" class="bg-white text-[#22562A] px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-colors">
            SHOP NOW
          </a>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-bold text-3xl text-gray-900 mb-8">Kategori</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <a href="/shop?category=<%= cat.id %>" class="group relative overflow-hidden rounded-xl bg-gray-100 aspect-[4/3]">
                <div class="absolute inset-0 bg-[#22562A]/40 group-hover:bg-[#22562A]/60 transition-all flex items-end p-4">
                  <span class="text-white font-semibold text-lg"><%= cat.name %></span>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <% ['T-Shirt','Hoodie','Pants'].forEach(name => { %>
              <a href="/shop" class="group relative overflow-hidden rounded-xl aspect-[4/3]">
                <img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=400&q=60" alt="<%= name %>"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                <div class="absolute inset-0 bg-[#22562A]/40 group-hover:bg-[#22562A]/60 transition-all flex items-end p-4">
                  <span class="text-white font-semibold text-lg"><%= name %></span>
                </div>
              </a>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Featured Products -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-bold text-3xl text-gray-900">Produk Unggulan</h2>
          <a href="/shop" class="text-[#22562A] font-medium text-sm hover:underline">Lihat Semua →</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          <% if (featured && featured.length > 0) { %>
            <% featured.forEach(product => { %>
              <a href="/product/<%= product.slug %>" class="group">
                <div class="bg-gray-50 rounded-xl overflow-hidden mb-3 aspect-[3/4]">
                  <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=400' %>"
                    alt="<%= product.name %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-medium text-gray-900 text-sm mb-1"><%= product.name %></h3>
                <p class="text-[#22562A] font-semibold text-sm">Rp <%= product.price ? product.price.toLocaleString('id-ID') : '-' %></p>
              </a>
            <% }) %>
          <% } else { %>
            <% for (let i = 0; i < 4; i++) { %>
              <div class="group">
                <div class="bg-gray-100 rounded-xl overflow-hidden mb-3 aspect-[3/4] animate-pulse"></div>
                <div class="h-4 bg-gray-100 rounded mb-1"></div>
                <div class="h-4 bg-gray-100 rounded w-2/3"></div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
